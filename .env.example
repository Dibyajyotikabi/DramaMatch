# Public URL of the deployed site (used for social previews and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live data: every movie and series, trending rows, posters, cast and trailers.
# Free key: https://www.themoviedb.org/settings/api ("API Key"). Without it the
# app uses its built-in catalog of 450+ titles.
TMDB_API_KEY=
# Alternatively, the long "API Read Access Token" from the same page:
# TMDB_READ_TOKEN=

# Optional: show real IMDb ratings on title pages. Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
