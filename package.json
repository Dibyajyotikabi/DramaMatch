{
  "name": "dramamatch",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write app components lib scripts tests next.config.ts",
    "check:tmdb": "tsx scripts/check-tmdb.ts",
    "mock:tmdb": "tsx tests/mock-tmdb.ts",
    "clean": "node -e \"for (const d of ['.next','node_modules','tsconfig.tsbuildinfo']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "fresh": "npm run clean && npm install"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^1.52.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
